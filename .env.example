# 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 커밋하지 않는다)
OPENAI_API_KEY=
# OpenRouter 등 OpenAI 호환 제공사를 쓸 때만. OpenAI 직접이면 줄째 지운다
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
# 공고 카드(공고마다 한 번, 재사용)에 쓸 모델. 비우면 LLM_MODEL
CARD_MODEL=anthropic/claude-haiku-5.5
# Serper 웹 검색 키 (https://serper.dev)
SERPER_API_KEY=
